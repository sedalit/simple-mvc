{
    "name": "sedalit/simple-mvc-framework",
    "type": "library",
    "autoload": {
        "psr-4": {
            "PHPFramework\\": "src/"
        },
        "files": [
            "helpers/functions.php"
        ],
        "classmap": [
            "src/"
        ]
    },
    "require": {
        "symfony/var-dumper": "^5.4",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.10",
        "symfony/dotenv": "^5.4"
    },
    "authors": [
        {
            "name": "Vladislav Agarkov",
            "email": "vlad.agarkov@alto-ai.ru"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "classmap": [
            "src/"
        ]
    }
}
